---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="FAREAST LEGION SF PARATROOPERS">
<header class="topbar"><div class="container nav"><a class="brand" href="#home"><img src="/assets/logo.jpg" alt="FAREAST LEGION SF PARATROOPERS Logo"><span>FAREAST LEGION<br>SF PARATROOPERS</span></a><button class="hamb" id="hamb">☰</button><nav class="menu" id="menu"><a href="#home">Home</a><a href="#who">Who We Are</a><a href="#mission">Mission</a><a href="#programs">Programs / Events</a><a href="#gallery">Gallery</a><a href="#membership">Membership</a><a href="#contact">Contact</a></nav></div></header>
<main>
<section class="hero" id="home"><div class="container hero-inner"><img class="crest" src="/assets/logo.jpg" alt="Logo"><div class="label">Elite Association • Airborne Heritage</div><h1>Upholding the Legacy of the Elite Forces</h1><div class="hero-title">FAREAST LEGION SF PARATROOPERS</div><div class="tagline">Honoring airborne tradition, mastering tactical excellence.</div><p>Join a professional association defined by discipline, brotherhood, elite professionalism, international camaraderie, enduring service, tactical readiness, airborne heritage, and lasting impact.</p><div class="btn-row"><a class="btn gold" href="#who">Learn More About Us</a><a class="btn dark" href="#programs">View Programs / Events</a><a class="btn dark" href="#contact">Contact Us</a></div></div></section>
<section id="who"><div class="container"><h2 class="section-title">Who We Are</h2><p class="lead"><b>FAREAST LEGION SF PARATROOPERS</b> is an association composed of paratroopers, Special Forces, elite police, military personnel, bureaus, and allied-country counterparts, including active duty personnel, reserve personnel, and retired personnel.</p><div class="panel mt"><p>The organization is built on shared experience, discipline, service, brotherhood, international camaraderie, and commitment to professional excellence.</p></div></div></section>
<section id="mission"><div class="container split"><div class="panel"><h2 class="section-title">Mission</h2><p>To preserve airborne heritage, strengthen brotherhood, promote discipline, and uphold professional excellence among elite forces, law enforcement personnel, military members, allied-country counterparts, and qualified individuals.</p></div><div class="panel"><h2 class="section-title">Vision</h2><p>To become a respected international association built on service, tactical readiness, leadership, airborne heritage, international camaraderie, and enduring legacy.</p></div></div></section>
<section id="programs"><div class="container"><h2 class="section-title">Programs / Events</h2><p class="lead">Designed for law enforcers, military personnel, private safety and security professionals, aspiring LEA applicants, tactical enthusiasts, and qualified individuals seeking practical programs, events, courses, challenges, exercises, or professional development.</p><div class="program-grid"><article class="program-card"><img src="/assets/program-cqb.jpg" alt="CQB"><div class="content"><h3>Special Tactical Response CQB</h3><p>Focused on controlled movement, teamwork, tactical awareness, response readiness, and professional standards.</p></div></article><article class="program-card"><img src="/assets/program-marksmanship.jpg" alt="Marksmanship"><div class="content"><h3>Iron Sight Marksmanship Challenge</h3><p>Emphasizing fundamentals, discipline, consistency, practical shooting performance, and professional development.</p></div></article><article class="program-card"><img src="/assets/program-scuba.jpg" alt="Scuba"><div class="content"><h3>Military Scuba Diver</h3><p>Centered on diver operations, open-water capability, mission tasks, team coordination, and adaptive problem-solving.</p></div></article></div><div class="notice"><h3>Awards and Certification Notice</h3><p>All badges, certificates, and qualification awards shall be issued only by the authorized host or instructor who conducted the respective program.</p><p>However, the issuance, recognition, classification, or modification of such awards shall remain subject to the approval of FLP, based on qualifications deemed fit and appropriate. Certain badges, certificates, or qualification awards may not be applicable to all programs and shall be issued only when relevant to the nature, scope, and requirements of the respective program conducted.</p></div></div></section>
<section id="gallery"><div class="container"><h2 class="section-title">Gallery</h2><p class="lead">Previous tactical operation programs, events, airborne heritage, maritime activities, field activities, and professional development photos.</p><div class="gallery-grid"><button class="gallery-item" data-img="/assets/gallery-cqb-field.jpg"><img src="/assets/gallery-cqb-field.jpg" alt="CQB Field"></button><button class="gallery-item" data-img="/assets/gallery-maritime-1.jpg"><img src="/assets/gallery-maritime-1.jpg" alt="Maritime"></button><button class="gallery-item" data-img="/assets/gallery-maritime-2.jpg"><img src="/assets/gallery-maritime-2.jpg" alt="Open Water"></button><button class="gallery-item" data-img="/assets/gallery-range.jpg"><img src="/assets/gallery-range.jpg" alt="Range"></button><button class="gallery-item" data-img="/assets/gallery-maritime-3.jpg"><img src="/assets/gallery-maritime-3.jpg" alt="Maritime Team"></button><button class="gallery-item" data-img="/assets/gallery-airborne.jpg"><img src="/assets/gallery-airborne.jpg" alt="Airborne"></button></div></div></section>
<section id="membership"><div class="container"><h2 class="section-title">Membership</h2><p class="lead">Membership is intended for qualified paratroopers, Special Forces, elite police, military personnel, bureaus, allied-country counterparts, active duty personnel, reserve personnel, retired personnel, and qualified individuals who share the values of discipline, service, brotherhood, international camaraderie, and professional excellence.</p><div class="values"><div class="value">Discipline</div><div class="value">Brotherhood</div><div class="value">Service</div><div class="value">Excellence</div></div></div></section>
<section id="contact"><div class="container contact-grid"><div><h2 class="section-title">Contact Us</h2><p class="lead">For official inquiries, membership, programs, events, courses, challenges, tactical operation exercises, and professional development, contact us using the form below.</p><div class="email-box">fareastlegionsfparatroopers@gmail.com</div></div><div class="panel"><form action="mailto:fareastlegionsfparatroopers@gmail.com" method="post" enctype="text/plain"><input type="text" name="Full Name" placeholder="Full Name" required><input type="email" name="Email Address" placeholder="Email Address" required><input type="tel" name="Mobile Contact Number" placeholder="Mobile Contact Number"><input type="text" name="Country" placeholder="Country"><input type="text" name="Background / Affiliation" placeholder="Background / Affiliation"><textarea name="Message" placeholder="Message" required></textarea><button class="btn gold" type="submit">Send Message</button></form></div></div></section>
</main>
<button class="ai-fab" id="aiFab">AI Assistant</button><div class="ai-panel" id="aiPanel"><div class="ai-head"><strong>FAREAST LEGION AI Assistant</strong><button class="ai-close" id="aiClose">×</button></div><div class="ai-body" id="aiBody"><div class="ai-msg bot">Welcome to FAREAST LEGION SF PARATROOPERS. Ask about membership, programs/events, contact details, or awards and certification notice.</div></div><div class="ai-quick"><button data-topic="membership">Membership</button><button data-topic="programs">Programs / Events</button><button data-topic="contact">Contact</button><button data-topic="awards">Awards Notice</button></div><div class="ai-input"><input id="aiInput" type="text" placeholder="Ask a question..."><button id="aiSend">Send</button></div></div>
<div class="lightbox" id="lightbox"><button id="lightboxClose">×</button><img id="lightboxImg" src="" alt="Expanded gallery image"></div><footer><div class="container">© 2026 FAREAST LEGION SF PARATROOPERS. All Rights Reserved.</div></footer>
<style>
:root{--black:#040404;--gold:#c88422;--gold2:#f1c15b;--white:#f4f4f4;--muted:#b9b9b9;--line:rgba(241,193,91,.35);--panel:rgba(14,16,19,.92)}*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:Arial,Helvetica,sans-serif;color:var(--white);background:radial-gradient(circle at 20% 0%,rgba(200,132,34,.12),transparent 35%),radial-gradient(circle at 100% 20%,rgba(39,52,31,.18),transparent 30%),repeating-linear-gradient(90deg,rgba(255,255,255,.025) 0 1px,transparent 1px 56px),#040404;overflow-x:hidden;line-height:1.65}body:before{content:"";position:fixed;inset:0;z-index:-2;background:linear-gradient(rgba(0,0,0,.58),rgba(0,0,0,.86)),url('/assets/hero-parachute.jpg') center/cover no-repeat;filter:grayscale(.15) contrast(1.08);opacity:.48}a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.container{width:min(1200px,92%);margin:0 auto}.topbar{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(3,3,3,.78);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:14px;text-transform:uppercase;font-weight:900;color:var(--gold2);letter-spacing:1px}.brand img{width:60px;height:60px;object-fit:contain;filter:drop-shadow(0 0 12px rgba(241,193,91,.28))}.brand span{line-height:1.05;font-size:14px}.menu{display:flex;gap:18px;align-items:center;text-transform:uppercase;font-size:12px;letter-spacing:1.2px;color:#d2d2d2;font-weight:800}.menu a:hover{color:var(--gold2)}.hamb{display:none;background:transparent;border:1px solid var(--line);color:var(--gold2);padding:10px 12px;border-radius:8px;font-size:22px}.hero{min-height:100vh;padding:130px 0 86px;display:grid;place-items:center;text-align:center;position:relative}.hero-inner{position:relative;z-index:2;max-width:1040px}.crest{width:min(330px,62vw);margin:0 auto 24px;filter:drop-shadow(0 0 28px rgba(241,193,91,.32))}.label{display:inline-flex;border:1px solid var(--line);padding:10px 18px;border-radius:999px;background:rgba(0,0,0,.35);color:var(--gold2);font-size:12px;font-weight:900;letter-spacing:2.4px;text-transform:uppercase;margin-bottom:18px}h1{font-size:clamp(40px,7.5vw,92px);line-height:.92;letter-spacing:2px;text-transform:uppercase;text-shadow:0 8px 26px rgba(0,0,0,.9);margin-bottom:18px}.hero-title{font-size:clamp(20px,3.2vw,34px);letter-spacing:5px;color:var(--gold2);text-transform:uppercase;font-weight:900;margin-bottom:12px}.tagline{font-size:19px;color:#eee;font-style:italic;margin-bottom:18px}.hero p{max-width:820px;margin:0 auto 30px;color:#d4d4d4;font-size:17px}.btn-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.btn{padding:14px 22px;border:1px solid var(--gold);border-radius:6px;text-transform:uppercase;letter-spacing:1.3px;font-weight:900;font-size:13px;min-width:190px;transition:.22s}.btn.gold{background:linear-gradient(135deg,var(--gold2),var(--gold));color:#111;box-shadow:0 0 22px rgba(241,193,91,.25)}.btn.dark{background:rgba(0,0,0,.42);color:var(--gold2)}section{padding:86px 0;border-top:1px solid rgba(241,193,91,.16)}.section-title{text-transform:uppercase;font-size:clamp(28px,4vw,48px);letter-spacing:3px;line-height:1;margin-bottom:18px}.section-title:after{content:"";display:block;width:86px;height:3px;background:linear-gradient(90deg,var(--gold2),transparent);margin-top:14px}.lead{color:var(--muted);font-size:17px;max-width:960px}.mt{margin-top:24px}.split{display:grid;grid-template-columns:1fr 1fr;gap:24px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px;box-shadow:0 24px 70px rgba(0,0,0,.34)}.program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:30px}.program-card{background:rgba(0,0,0,.58);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 24px 70px rgba(0,0,0,.36);transition:.25s}.program-card img{width:100%;height:520px;object-fit:cover;background:#000}.program-card .content{padding:20px}.program-card h3{color:var(--gold2);text-transform:uppercase;letter-spacing:1.5px;font-size:18px;margin-bottom:8px}.program-card p{color:#c7c7c7;font-size:15px}.notice{margin-top:30px;background:rgba(0,0,0,.55);border-left:4px solid var(--gold);border-radius:10px;padding:24px;color:#cfcfcf}.notice h3{color:var(--gold2);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px}.notice p+p{margin-top:12px}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:30px}.gallery-item{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#000;min-height:260px;box-shadow:0 24px 60px rgba(0,0,0,.32);cursor:pointer;position:relative;padding:0}.gallery-item img{height:100%;width:100%;min-height:260px;object-fit:cover;transition:.25s}.values{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:24px}.value{padding:22px 18px;background:linear-gradient(145deg,rgba(200,132,34,.12),rgba(255,255,255,.035));border:1px solid var(--line);border-radius:14px;text-align:center;text-transform:uppercase;font-weight:900;letter-spacing:1.1px}.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px}form{display:grid;gap:14px}input,textarea{width:100%;padding:14px 15px;background:rgba(0,0,0,.5);border:1px solid var(--line);border-radius:8px;color:var(--white);outline:none}textarea{min-height:132px;resize:vertical}.email-box{margin-top:22px;color:var(--gold2);font-weight:900;word-break:break-word;letter-spacing:.7px}footer{padding:30px 0;text-align:center;background:rgba(0,0,0,.75);border-top:1px solid var(--line);color:var(--muted);font-size:13px}.ai-fab{position:fixed;right:22px;bottom:22px;z-index:2000;border:1px solid var(--gold);background:linear-gradient(135deg,var(--gold2),var(--gold));color:#111;font-weight:900;letter-spacing:1px;text-transform:uppercase;padding:14px 18px;border-radius:999px;box-shadow:0 0 25px rgba(241,193,91,.38);cursor:pointer}.ai-panel{position:fixed;right:22px;bottom:82px;width:min(410px,calc(100vw - 32px));max-height:74vh;z-index:2000;display:none;flex-direction:column;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:rgba(7,8,9,.98);box-shadow:0 22px 60px rgba(0,0,0,.7)}.ai-panel.open{display:flex}.ai-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:linear-gradient(135deg,rgba(241,193,91,.18),rgba(0,0,0,.2));border-bottom:1px solid var(--line)}.ai-head strong{color:var(--gold2);text-transform:uppercase;letter-spacing:1.4px;font-size:14px}.ai-close{background:transparent;border:none;color:var(--white);font-size:25px;cursor:pointer}.ai-body{padding:14px;overflow-y:auto;display:grid;gap:10px}.ai-msg{padding:11px 12px;border-radius:11px;font-size:14px;line-height:1.45}.ai-msg.bot{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);color:#d0d0d0}.ai-msg.user{background:rgba(241,193,91,.15);border:1px solid var(--line);justify-self:end;max-width:86%}.ai-quick{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 14px 14px}.ai-quick button{border:1px solid var(--line);background:rgba(0,0,0,.35);color:var(--gold2);padding:10px;border-radius:8px;cursor:pointer;text-transform:uppercase;letter-spacing:.8px;font-size:11px;font-weight:900}.ai-input{display:flex;gap:8px;padding:12px;border-top:1px solid var(--line);background:rgba(0,0,0,.32)}.ai-input input{margin:0;flex:1}.ai-input button{min-width:82px;border:1px solid var(--gold);background:linear-gradient(135deg,var(--gold2),var(--gold));color:#111;border-radius:8px;font-weight:900;cursor:pointer;text-transform:uppercase}.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:3000;display:none;align-items:center;justify-content:center;padding:30px}.lightbox.open{display:flex}.lightbox img{max-height:88vh;max-width:94vw;border:1px solid var(--line);box-shadow:0 20px 80px #000}.lightbox button{position:absolute;top:20px;right:22px;background:rgba(0,0,0,.55);border:1px solid var(--line);color:#fff;font-size:30px;border-radius:50%;width:48px;height:48px;cursor:pointer}@media(max-width:980px){.split,.contact-grid{grid-template-columns:1fr}.program-grid,.gallery-grid{grid-template-columns:1fr}.program-card img{height:auto}.values{grid-template-columns:repeat(2,1fr)}}@media(max-width:820px){.hamb{display:block}.menu{position:absolute;left:4%;right:4%;top:82px;background:rgba(0,0,0,.94);border:1px solid var(--line);border-radius:14px;display:none;flex-direction:column;padding:18px;text-align:center}.menu.open{display:flex}}@media(max-width:520px){.brand img{width:48px;height:48px}.brand span{font-size:12px}section{padding:62px 0}.hero{padding-top:120px}.btn{width:100%}.values{grid-template-columns:1fr}.ai-fab{right:12px;bottom:12px;padding:12px 14px;font-size:12px}.ai-panel{right:10px;bottom:66px}.ai-quick{grid-template-columns:1fr}}
</style>
<script>
const hamb=document.getElementById('hamb'),menu=document.getElementById('menu');hamb?.addEventListener('click',()=>menu?.classList.toggle('open'));const aiFab=document.getElementById('aiFab'),aiPanel=document.getElementById('aiPanel'),aiClose=document.getElementById('aiClose'),aiBody=document.getElementById('aiBody'),aiInput=document.getElementById('aiInput'),aiSend=document.getElementById('aiSend');function addMessage(t,y){const m=document.createElement('div');m.className='ai-msg '+y;m.textContent=t;aiBody.appendChild(m);aiBody.scrollTop=aiBody.scrollHeight}function getAIReply(i){const q=i.toLowerCase();if(q.includes('member')||q.includes('join')||q.includes('apply'))return'Membership is intended for qualified paratroopers, Special Forces, elite police, military personnel, bureaus, allied-country counterparts, active duty personnel, reserve personnel, retired personnel, and qualified individuals who share discipline, service, brotherhood, international camaraderie, and professional excellence.';if(q.includes('program')||q.includes('event')||q.includes('course')||q.includes('challenge')||q.includes('exercise')||q.includes('cqb')||q.includes('scuba')||q.includes('marksmanship')||q.includes('kali'))return'Programs / Events include Special Tactical Response CQB, Iron Sight Marksmanship Challenge, Military Scuba Diver, Combat Diver, Combat Kali, CBRNE-HAZMAT, EOD / UDT, Airborne Heritage, and tactical operation exercises.';if(q.includes('contact')||q.includes('email')||q.includes('message'))return'For official inquiries, contact: fareastlegionsfparatroopers@gmail.com. You may also use the contact form on this website.';if(q.includes('award')||q.includes('certificate')||q.includes('badge')||q.includes('qualification'))return'All badges, certificates, and qualification awards shall be issued only by the authorized host or instructor who conducted the respective program, subject to FLP approval and relevance to the nature, scope, and requirements of the program.';return'I can answer basic questions about FAREAST LEGION SF PARATROOPERS membership, programs/events, contact details, and awards notice.'}function sendAI(){const t=aiInput.value.trim();if(!t)return;addMessage(t,'user');aiInput.value='';setTimeout(()=>addMessage(getAIReply(t),'bot'),300)}aiFab?.addEventListener('click',()=>aiPanel.classList.toggle('open'));aiClose?.addEventListener('click',()=>aiPanel.classList.remove('open'));aiSend?.addEventListener('click',sendAI);aiInput?.addEventListener('keydown',e=>{if(e.key==='Enter')sendAI()});document.querySelectorAll('.ai-quick button').forEach(b=>b.addEventListener('click',()=>{addMessage(b.textContent,'user');setTimeout(()=>addMessage(getAIReply(b.dataset.topic),'bot'),250)}));const lb=document.getElementById('lightbox'),li=document.getElementById('lightboxImg');document.querySelectorAll('.gallery-item').forEach(i=>i.addEventListener('click',()=>{li.src=i.dataset.img;lb.classList.add('open')}));document.getElementById('lightboxClose')?.addEventListener('click',()=>lb.classList.remove('open'));lb?.addEventListener('click',e=>{if(e.target===lb)lb.classList.remove('open')});
</script>
</BaseLayout>
